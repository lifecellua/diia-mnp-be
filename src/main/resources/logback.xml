<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="ua.gov.diia.logging.layout.DiiaJsonLayout">
                <stringMaxLength>${LOGGING_STRING_MAX_LEN:-2048}</stringMaxLength>
                <appendNewLine>${LOGGING_APPEND_NEW_LINE:-true}</appendNewLine>
                <hiddenProperties>otp, phone, customerData, token</hiddenProperties>
            </layout>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <neverBlock>true</neverBlock>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="json"/>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>
</configuration>